# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fonts
fonts/*
!fonts/init.mjs

# ide
.vscode
.idea
.cursor
.claude

.turbo/*
.devtools

# gói dữ liệu ban tổ chức cấp — chỉ dùng trong hackathon, không commit nguyên pack
/data

# code gốc của oss-gtm-feedback, giữ lại để tra cứu khi nối lại agent thật
apps/www/_removed

# Dữ liệu runs cục bộ
.data/
apps/www/.data/
