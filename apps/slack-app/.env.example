# slack app credentials
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# slack app verification (shared secret with the web app)
# you can use "openssl rand -base64 32" to create a secure secret
SLACK_APP_VERIFICATION=

# ai gateway (optional - either works)
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=

# ngrok token for local development tunneling (optional)
NGROK_AUTH_TOKEN=
