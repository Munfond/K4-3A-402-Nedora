{
  "extends": "//",
  "plugins": [".biome/no-console-prefer-logger.grit"],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "server/**/*.{ts,js}",
      "manifest.json",
      "nitro.config.ts",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "overrides": [
    {
      "includes": ["scripts/**/*.{ts,js}"],
      "linter": {
        "enabled": true,
        "rules": {
          "recommended": true,
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
