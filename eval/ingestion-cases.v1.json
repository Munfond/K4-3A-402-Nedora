{
  "version": "ingestion-v1",
  "purpose": "Code-side contract for loading the C5 JSON and survey CSV before model analysis.",
  "policy": "synthetic-only; loader expected values are evaluator-only and are never sent to the model",
  "sourceRefs": {
    "feedbackJson": "data/studio-pack/c5-feedbackradar/vi-du/gop-y-mau.json",
    "surveyCsv": "data/studio-pack/c5-feedbackradar/vi-du/khao-sat-mau.csv"
  },
  "cases": [
    {
      "caseId": "ING-01",
      "kind": "loader",
      "hardness": ["json-csv-merge", "survey-only", "sender-count"],
      "input": {
        "feedbackJson": "gop-y-mau.json",
        "surveyCsv": "khao-sat-mau.csv"
      },
      "expected": {
        "normalizedCount": 22,
        "modelInputCount": 21,
        "independentSenderCount": 20,
        "channelCounts": { "binh-luan": 7, "tin-nhan": 5, "khao-sat": 10 },
        "mergedIds": [
          "gy-001",
          "gy-005",
          "gy-006",
          "gy-009",
          "gy-013",
          "gy-015"
        ],
        "surveyOnlyIds": ["gy-019", "gy-020", "gy-021", "gy-022"],
        "noTextIds": ["gy-019"]
      },
      "passCriteria": [
        { "type": "normalized-count", "value": 22 },
        { "type": "model-input-count", "value": 21 },
        { "type": "independent-sender-count", "value": 20 },
        {
          "type": "merged-ids",
          "ids": ["gy-001", "gy-005", "gy-006", "gy-009", "gy-013", "gy-015"]
        },
        {
          "type": "survey-only-label",
          "id": "gy-019",
          "label": "chi-cham-diem"
        }
      ]
    },
    {
      "caseId": "ING-02",
      "kind": "loader",
      "hardness": ["field-precedence", "source-preservation"],
      "input": {
        "jsonId": "gy-001",
        "feedbackJson": "gop-y-mau.json",
        "surveyCsv": "khao-sat-mau.csv"
      },
      "expected": {
        "textSource": "json.noiDung",
        "understandingScoreSource": "csv.de_hieu_1_5",
        "paceScoreSource": "csv.nhip_do_1_5",
        "scoreSource": "json.diemSo",
        "textMustContain": "Đoạn giữa hơi nhanh, em không kịp ghi."
      },
      "passCriteria": [
        { "type": "field-source", "field": "text", "source": "json.noiDung" },
        {
          "type": "field-source",
          "field": "deHieu",
          "source": "csv.de_hieu_1_5"
        },
        {
          "type": "field-source",
          "field": "nhipDo",
          "source": "csv.nhip_do_1_5"
        },
        { "type": "field-source", "field": "diemSo", "source": "json.diemSo" }
      ]
    },
    {
      "caseId": "ING-03",
      "kind": "loader",
      "hardness": ["no-blank-model-input", "source-id"],
      "input": {
        "feedbackJson": "gop-y-mau.json",
        "surveyCsv": "khao-sat-mau.csv"
      },
      "expected": {
        "excludedFromModel": ["gy-019"],
        "retainedInTrace": ["gy-019"],
        "traceLabel": "chi-cham-diem",
        "allModelRecordsHaveText": true
      },
      "passCriteria": [
        { "type": "excluded-from-model", "ids": ["gy-019"] },
        { "type": "retained-in-trace", "ids": ["gy-019"] },
        { "type": "all-model-records-have-text", "value": true }
      ]
    }
  ]
}
